---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const start = new Date(2021, 11);
const now = new Date();
let years = now.getFullYear() - start.getFullYear();
let months = now.getMonth() - start.getMonth();
if (months < 0) { years--; months += 12; }
const exp = months > 0 ? `${years}.${months}` : `${years}`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={`Abiram — Frontend developer with ${exp} years of experience building clean, performant web applications with Angular, React, and modern web technologies.`} />
    <meta property="og:title" content="Abiram | Portfolio" />
    <meta property="og:description" content="Frontend developer specializing in Angular, React, and modern web technologies." />
    <meta property="og:type" content="website" />
    <title>Abiram | Portfolio</title>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("dark");

        var palette = [
          { bg: "#0f172a", accent: "#7dd3fc", name: "Deep Navy" },
          { bg: "#1a1a2e", accent: "#a78bfa", name: "Charcoal" },
          { bg: "#0d1b2a", accent: "#67e8f9", name: "Dark Teal" },
          { bg: "#064e3b", accent: "#fbbf24", name: "Emerald" },
          { bg: "#1e1b4b", accent: "#c4b5fd", name: "Deep Purple" },
          { bg: "#172554", accent: "#93c5fd", name: "Midnight Blue" },
          { bg: "#450a0a", accent: "#fca5a5", name: "Burgundy" },
          { bg: "#1c1917", accent: "#d6d3d1", name: "Warm Stone" },
          { bg: "#164e63", accent: "#5eead4", name: "Deep Cyan" },
          { bg: "#1e3a5f", accent: "#7dd3fc", name: "Ocean Blue" },
          { bg: "#2d1b69", accent: "#d8b4fe", name: "Royal Violet" },
          { bg: "#14532d", accent: "#fcd34d", name: "Forest Green" },
        ];

        var idx = Math.floor(Math.random() * palette.length);
        var chosen = palette[idx];
        d.style.setProperty("--bg-color-dark", chosen.bg);
        d.style.setProperty("--accent-color", chosen.accent);
        d.setAttribute("data-random-bg", "true");
        d.setAttribute("data-color-idx", String(idx));

        window.__palette = palette;
      })();
    </script>
  </head>
  <body
    class="font-mont bg-background-dark text-foreground-dark flex flex-col min-h-screen text-sm sm:text-base"
  >
    <Header />
    <main class="pt-10">
      <slot />
      <Footer />
    </main>

    <script>
      document.body.setAttribute(
        "data-pattern",
        localStorage.getItem("bg-pattern") || "dots"
      );

      function checkScroll() {
        const scrollY = window.scrollY;
        document.documentElement.toggleAttribute("data-scrolled", scrollY > 20);
        const atBottom =
          window.innerHeight + scrollY >=
          document.documentElement.scrollHeight - 40;
        document.documentElement.toggleAttribute("data-at-bottom", atBottom);
      }
      window.addEventListener("scroll", checkScroll, { passive: true });
      checkScroll();

      // Dev-only color picker (localhost only)
      if (location.hostname === "localhost") {
        const palette = (window as any).__palette as {
          bg: string;
          accent: string;
          name: string;
        }[];
        if (palette) {
          const currentIdx =
            document.documentElement.getAttribute("data-color-idx") || "0";

          const wrapper = document.createElement("div");
          wrapper.id = "dev-color-picker";
          Object.assign(wrapper.style, {
            position: "fixed",
            top: "1.5rem",
            right: "1.5rem",
            display: "flex",
            alignItems: "center",
            gap: "0.4rem",
            padding: "0.3rem 0.5rem",
            borderRadius: "0.5rem",
            background: "rgba(0,0,0,0.7)",
            backdropFilter: "blur(8px)",
            zIndex: "9999",
            fontSize: "0.7rem",
            color: "#aaa",
          });
          wrapper.innerHTML = `<label>BG</label>`;

          const select = document.createElement("select");
          Object.assign(select.style, {
            background: "rgba(255,255,255,0.1)",
            color: "#fff",
            border: "1px solid rgba(255,255,255,0.15)",
            borderRadius: "0.25rem",
            padding: "0.2rem 0.4rem",
            fontSize: "0.7rem",
            cursor: "pointer",
          });
          palette.forEach((p, i) => {
            const opt = document.createElement("option");
            opt.value = String(i);
            opt.textContent = p.name;
            opt.style.backgroundColor = p.bg;
            opt.style.color = p.accent;
            if (String(i) === currentIdx) opt.selected = true;
            select.appendChild(opt);
          });

          select.addEventListener("change", () => {
            const idx = parseInt(select.value, 10);
            const chosen = palette[idx];
            const d = document.documentElement;
            d.style.setProperty("--bg-color-dark", chosen.bg);
            d.style.setProperty("--accent-color", chosen.accent);
            d.setAttribute("data-color-idx", String(idx));
          });

          wrapper.appendChild(select);
          document.body.appendChild(wrapper);
        }
      }
    </script>

  </body>
</html>

---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

import { getExperience } from "../utils/experience.ts";

interface Props {
  title?: string;
  description?: string;
}

const { exp } = getExperience();

const {
  title = "Abiram | Portfolio",
  description = `Abiram — Frontend developer with ${exp} years of experience building clean, performant web applications with Angular, React, and modern web technologies.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Abiram",
  url: "https://www.abikb.xyz",
  jobTitle: "Frontend Engineer",
  worksFor: { "@type": "Organization", name: "Deloitte USI" },
  sameAs: [
    "https://www.github.com/abiramcodes",
    "https://www.linkedin.com/in/abirama-kannan-baskar",
    "https://x.com/abiramcodes",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfcfa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101214" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      // Resolve the theme before first paint: stored choice wins,
      // otherwise follow the OS. Also flag JS so reveal states only
      // hide content when they can be revealed again.
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        try {
          var stored = localStorage.getItem("theme");
          var dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          d.setAttribute("data-theme", dark ? "dark" : "light");
        } catch (e) {
          d.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body
    class="font-sans bg-background-dark text-foreground-dark flex flex-col min-h-screen text-sm sm:text-base antialiased"
  >
    <Header />
    <main class="pt-10">
      <slot />
      <Footer />
    </main>

    <script>
      function checkScroll() {
        const scrollY = window.scrollY;
        document.documentElement.toggleAttribute("data-scrolled", scrollY > 20);
        const atBottom =
          window.innerHeight + scrollY >=
          document.documentElement.scrollHeight - 40;
        document.documentElement.toggleAttribute("data-at-bottom", atBottom);
      }
      window.addEventListener("scroll", checkScroll, { passive: true });
      checkScroll();

      // Scroll-entry reveals. Content is visible by default; the head
      // script's `js` class enables the hidden start state, and this
      // observer resolves it as blocks enter the viewport.
      if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("revealed");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("revealed"));
      }
    </script>

  </body>
</html>

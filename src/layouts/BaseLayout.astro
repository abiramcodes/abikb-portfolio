---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { socials } from "../data/content";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Opt into the wide (72rem) wrap. Home first; other pages follow. */
  wide?: boolean;
}

const {
  title = "Abiram — Frontend Engineer",
  description = "Abiram — Frontend developer building clean, performant web applications with Angular, React, and modern web technologies.",
  wide = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Abiram",
  url: "https://www.abikb.xyz",
  jobTitle: "Frontend Engineer",
  worksFor: { "@type": "Organization", name: "Deloitte USI" },
  sameAs: socials.map((s) => s.href),
};
---

<html lang="en" data-type="software" data-wide={wide || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfcfa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101214" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      // Resolve the theme before first paint: stored choice wins,
      // otherwise follow the OS.
      (function () {
        var d = document.documentElement;
        try {
          var stored = localStorage.getItem("theme");
          var dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          d.setAttribute("data-theme", dark ? "dark" : "light");
        } catch (e) {
          d.setAttribute("data-theme", "light");
        }
        try {
          d.setAttribute("data-sound", localStorage.getItem("sound") === "off" ? "off" : "on");
        } catch (e) {
          d.setAttribute("data-sound", "on");
        }
      })();
    </script>
  </head>
  <body
    class="font-sans bg-background-dark text-foreground-dark flex flex-col min-h-dvh text-sm sm:text-base antialiased"
  >
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" class="pt-10 flex-1 flex flex-col">
      <slot />
    </main>
    <Footer />

    <script>
      import { playCopy } from "../utils/sfx";

      function checkScroll() {
        const scrollY = window.scrollY;
        document.documentElement.toggleAttribute("data-scrolled", scrollY > 20);
        const atBottom =
          window.innerHeight + scrollY >=
          document.documentElement.scrollHeight - 40;
        document.documentElement.toggleAttribute("data-at-bottom", atBottom);
      }
      window.addEventListener("scroll", checkScroll, { passive: true });
      checkScroll();

      // Copy-to-clipboard for install-command chips, site-wide.
      // The label swap is masked with a brief blur so the two states
      // read as one morph instead of a hard text flash.
      document.querySelectorAll<HTMLElement>("[data-copy]").forEach((el) => {
        el.addEventListener("click", async () => {
          const text = el.getAttribute("data-copy");
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            const ta = document.createElement("textarea");
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand("copy");
            ta.remove();
          }
          playCopy();
          const label = el.textContent;
          el.classList.add("is-swapping");
          window.setTimeout(() => {
            el.textContent = "Copied!";
            el.classList.remove("is-swapping");
          }, 160);
          window.setTimeout(() => {
            el.classList.add("is-swapping");
            window.setTimeout(() => {
              el.textContent = label;
              el.classList.remove("is-swapping");
            }, 160);
          }, 1200);
        });
      });

      const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
      const noMotion = window.matchMedia("(prefers-reduced-motion: no-preference)");

      // Magnetic elements — hero CTAs and header controls drift a
      // few pixels toward the pointer and ease back. Independent
      // translate composes with the existing :active scale transforms.
      if (finePointer.matches && noMotion.matches) {
        const clamp = (v: number, limit: number) => Math.max(-limit, Math.min(limit, v));
        document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((el) => {
          el.addEventListener("pointermove", (e) => {
            const r = el.getBoundingClientRect();
            const dx = e.clientX - (r.left + r.width / 2);
            const dy = e.clientY - (r.top + r.height / 2);
            el.style.translate = `${clamp(dx * 0.25, 3)}px ${clamp(dy * 0.25, 3)}px`;
          });
          el.addEventListener("pointerout", (e) => {
            if (!el.contains(e.relatedTarget as Node)) el.style.removeProperty("translate");
          });
        });
      }
    </script>

  </body>
</html>

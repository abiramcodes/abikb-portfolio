---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Abiram | Frontend engineer",
  description = "Abiram, frontend engineer building micro frontends and modern Angular, React, and Astro applications. Tools, open source, and experience.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Abiram",
  url: "https://www.abikb.xyz",
  jobTitle: "Frontend Engineer",
  worksFor: { "@type": "Organization", name: "Deloitte USI" },
  sameAs: [
    "https://www.github.com/abiramcodes",
    "https://www.linkedin.com/in/abirama-kannan-baskar",
    "https://x.com/abiramcodes",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0E1720" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      // Restore the stored palette choice before first paint so the
      // workbench never flashes in the wrong material. Silver is the
      // default; no attribute means the silver token set applies.
      (function () {
        try {
          if (localStorage.getItem("af82-pal") === "walnut") {
            document.documentElement.setAttribute("data-pal", "walnut");
          }
        } catch (e) {
          /* storage unavailable: silver applies */
        }
      })();
    </script>
    <link
      rel="preload"
      href="/fonts/archivo-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body class="bg-bench flex flex-col min-h-screen">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="flex-1 flex flex-col">
      <slot />
    </main>
    <Footer />

    <script>
      // Equipment strip separation: transparent at rest, opaque once
      // the console scrolls under it.
      function checkScroll() {
        document.documentElement.toggleAttribute("data-scrolled", window.scrollY > 20);
      }
      window.addEventListener("scroll", checkScroll, { passive: true });
      checkScroll();
    </script>
  </body>
</html>

---
import { Moon, Sun } from "@lucide/astro";
import { SITE_TITLE } from "../consts";
import { navPages, socials } from "../data/content";
import Center from "./Center.astro";
import SearchPalette from "./SearchPalette.astro";

interface Props {
  title?: string;
}

const { title = SITE_TITLE } = Astro.props;

const githubIcon = socials.find((s) => s.label === "GitHub")!.icon;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

// Dock icons keyed by route. The GitHub mark is the real brand path.
const dockIcons: Record<string, { path: string; filled?: boolean }> = {
  "/": { path: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" },
  "/projects": { path: "M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" },
  "/open-source": { path: githubIcon, filled: true },
  "/skills": { path: "m8 8-4 4 4 4m8-8 4 4-4 4" },
  "/experience": { path: "M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m8 0H8m8 0a2 2 0 012 2v1M8 6a2 2 0 00-2 2v1" },
};
---

<Center>
  <header
    class="w-full max-w-3xl mx-auto flex items-center justify-between min-w-0 mt-4 px-4 sm:px-0"
  >
    <a href="/" class="font-display text-3xl text-foreground-dark truncate py-1">
      {title}<span class="text-accent">.</span>
    </a>

    <div class="flex items-center gap-5">
      <!-- Desktop inline nav -->
      <nav class="hidden sm:flex items-center gap-6 text-sm" aria-label="Primary">
        {
          navPages.map((page) => (
            <a
              href={page.href}
              class:list={["nav-link link-draw py-2", { active: currentPath === page.href }]}
              aria-current={currentPath === page.href ? "page" : undefined}
            >
              {page.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <button
          type="button"
          class="palette-trigger"
          popovertarget="search-palette"
          data-magnetic
          aria-label="Open search"
        >
          <svg
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" />
            <path stroke-linecap="round" d="m20 20-3.8-3.8" />
          </svg>
          <kbd data-kbd-hint class="hidden sm:inline">⌘ K</kbd>
        </button>

        <button
          id="theme-toggle"
          type="button"
          data-magnetic
          class="theme-toggle"
          aria-label="Toggle color theme"
          title="Toggle color theme"
        >
          <Moon class="theme-icon-moon" size={20} stroke-width={1.8} aria-hidden="true" />
          <Sun class="theme-icon-sun" size={20} stroke-width={1.8} aria-hidden="true" />
        </button>
      </div>
    </div>
  </header>
</Center>

<!-- Floating bottom dock (mobile) -->
<nav
  id="bottom-dock"
  class="sm:hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-50 flex items-center gap-0.5 px-1.5 py-1.5 rounded-full border border-line bg-surface/90 backdrop-blur-xl"
  aria-label="Primary"
>
  {
    navPages.map((page) => {
      const icon = dockIcons[page.href];
      const active = currentPath === page.href;
      return (
        <a
          href={page.href}
          class:list={["dock-item pressable", { active }]}
          aria-current={active ? "page" : undefined}
        >
          {icon.filled ? (
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d={icon.path} clip-rule="evenodd" />
            </svg>
          ) : (
            <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={icon.path} />
            </svg>
          )}
          <span>{page.dockLabel ?? page.label}</span>
        </a>
      );
    })
  }
</nav>

<SearchPalette />

<script>
  // Lift the dock above the footer when it enters the viewport so
  // footer text is never covered. Dock stays visible for navigation.
  const dock = document.getElementById("bottom-dock");
  const foot = document.querySelector("footer");
  if (dock && foot) {
    const syncFooter = () => {
      const r = foot.getBoundingClientRect();
      const visible = r.top < window.innerHeight && r.bottom > 0;
      dock.classList.toggle("footer-visible", visible);
    };
    new IntersectionObserver(syncFooter, { threshold: 0.05 }).observe(foot);
    window.addEventListener("scroll", syncFooter, { passive: true });
    syncFooter();
  }

  // Theme toggle. Resolved theme = explicit attribute if present,
  // otherwise the OS preference — a missing attribute must never be
  // assumed to mean light, or the first click under a dark OS would
  // "switch" to the already-visible dark and look broken.
  const rootEl = document.documentElement;
  const systemQuery = window.matchMedia("(prefers-color-scheme: dark)");

  function resolvedTheme(): string {
    const attr = rootEl.getAttribute("data-theme");
    if (attr === "dark" || attr === "light") return attr;
    return systemQuery.matches ? "dark" : "light";
  }

  function storedTheme(): string | null {
    try {
      return localStorage.getItem("theme");
    } catch (e) {
      return null;
    }
  }

  function applyTheme(target: string, animate: boolean) {
    if (animate) rootEl.classList.add("theme-anim");
    rootEl.setAttribute("data-theme", target);
    if (animate) window.setTimeout(() => rootEl.classList.remove("theme-anim"), 250);
  }

  // Heal any missing attribute up front so icon state and the first
  // click both start from the truth.
  applyTheme(resolvedTheme(), false);

  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const target = resolvedTheme() === "dark" ? "light" : "dark";
    try {
      // Store only when diverging from the OS; matching it clears the
      // override so the site follows the system again.
      if (target === (systemQuery.matches ? "dark" : "light")) localStorage.removeItem("theme");
      else localStorage.setItem("theme", target);
    } catch (e) {
      /* storage unavailable: theme still applies for this page */
    }
    applyTheme(target, true);
  });

  // Follow live OS changes only while the user hasn't pinned a choice.
  systemQuery.addEventListener("change", () => {
    if (!storedTheme()) applyTheme(systemQuery.matches ? "dark" : "light", true);
  });
</script>

<style>
  .nav-link {
    color: var(--muted-text);
  }
  .nav-link.active {
    color: var(--accent);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--accent);
    }
  }

  .theme-toggle {
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    color: var(--muted-text);
    border: 1px solid var(--line);
    background: var(--surface);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      color 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover {
      color: var(--accent);
    }
  }

  .palette-trigger {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.75rem;
    padding: 0 0.9rem;
    border-radius: 9999px;
    color: var(--muted-text);
    border: 1px solid var(--line);
    background: var(--surface);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      color 200ms var(--ease-out);
  }
  .palette-trigger kbd {
    font-family: "Geist Mono", monospace;
    font-size: 0.65rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .palette-trigger:hover {
      color: var(--accent);
    }
  }

  /* Lift via independent translate so the centered -translate-x-1/2
     transform keeps composing; bottom never animates (layout). */
  #bottom-dock {
    transition: translate 200ms var(--ease-in-out);
  }
  #bottom-dock.footer-visible {
    translate: 0 -5.25rem;
  }
  @media (prefers-reduced-motion: reduce) {
    #bottom-dock {
      transition: none;
    }
  }
  .dock-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--muted-text);
    transition:
      transform 160ms var(--ease-out),
      color 200ms var(--ease-out),
      background-color 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .dock-item:hover {
      color: var(--ink);
      background: var(--surface-2);
    }
  }
  .dock-item.active {
    color: var(--accent);
    background: var(--accent-bg);
  }
</style>

---
import { SITE_TITLE } from "../consts";
import Center from "./Center.astro";

interface Props {
  title?: string;
}

const { title = SITE_TITLE } = Astro.props;
---

<Center>
  <header
    class="w-full max-w-2xl mx-auto flex items-center justify-between min-w-0 mt-4 px-4 sm:px-0"
  >
    <a
      href="/"
      class="text-2xl font-bold text-foreground-dark truncate"
    >
      {title}<span class="text-accent">.</span>
    </a>

    <!-- Desktop inline nav -->
    <nav class="hidden sm:flex items-center gap-6 text-sm">
      <a href="/" class="nav-link">Home</a>
      <a href="/projects" class="nav-link">Projects</a>
      <a href="/experience" class="nav-link">Experience</a>
    </nav>
  </header>
</Center>

<!-- Floating bottom dock (mobile) -->
<nav
  id="bottom-dock"
  class="sm:hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-50 flex items-center gap-1 px-2 py-1.5 rounded-full border border-white/10 bg-white/5 backdrop-blur-xl"
>
  <a href="/" class="dock-item" data-page="/">
    <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" />
    </svg>
    <span>Home</span>
  </a>
  <a href="/projects" class="dock-item" data-page="/projects">
    <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
    </svg>
    <span>Projects</span>
  </a>
  <a href="/experience" class="dock-item" data-page="/experience">
    <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m8 0H8m8 0a2 2 0 012 2v1M8 6a2 2 0 00-2 2v1" />
    </svg>
    <span>Experience</span>
  </a>
</nav>

<script>
  const path = window.location.pathname.replace(/\/$/, "") || "/";
  document.querySelectorAll<HTMLAnchorElement>(".dock-item").forEach((el) => {
    const page = el.dataset.page || "/";
    if (page === path) el.classList.add("active");
  });
  document.querySelectorAll<HTMLAnchorElement>(".nav-link").forEach((el) => {
    const href = (el.getAttribute("href") || "/").replace(/\/$/, "") || "/";
    if (href === path) el.classList.add("active");
  });
</script>

<style>
  .nav-link {
    color: rgba(255, 255, 255, 0.5);
    transition: color 0.2s var(--ease-out);
  }
  .nav-link.active {
    color: var(--accent-color, #839788);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--accent-color, #839788);
    }
  }

  .dock-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
    transition:
      color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .dock-item:hover {
      color: rgba(255, 255, 255, 0.8);
      background: rgba(255, 255, 255, 0.06);
    }
  }
  .dock-item.active {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }
</style>

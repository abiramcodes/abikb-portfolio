---
import { projects } from "../data/content";
import ProjectCard from "./ProjectCard.astro";
---

<section class="w-full max-w-3xl mx-auto px-4 sm:px-0">
  <h1 class="font-display text-4xl sm:text-5xl tracking-[-0.02em] mb-3">Projects</h1>
  <p class="text-secondary-dark mb-8">Tools and demos, built in the open.</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

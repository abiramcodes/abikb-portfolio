---
import { SIDE_A } from "../data/projects";
import TransportKey from "./cassette/TransportKey.astro";

// The /projects library: full tape cases for the authored tools,
// a rack for the remaining personal work. Side B client work is
// rendered by WorkProjects.astro below this section.
const featured = SIDE_A.filter((p) => p.command);
const rack = SIDE_A.filter((p) => !p.command);
---

<section class="w-full" aria-labelledby="library-h">
  <h2 id="library-h" class="t-head font-black tracking-tight m-0">Projects</h2>
  <p class="t-body text-muted m-0 mt-1.5">Tools and demos, built in the open.</p>

  <div class="flex flex-col gap-4 mt-6">
    {
      featured.map((tool, i) => (
        <article
          class="hw-panel p-5 sm:p-6 sm:flex sm:items-center sm:gap-6 min-w-0"
          id={tool.id}
        >
          <svg
            class="w-[132px] sm:w-[160px] h-auto shrink-0"
            viewBox="0 0 160 60"
            aria-hidden="true"
          >
            <rect x="2" y="4" width="156" height="52" rx="6" class="hw-svg-deck" />
            <rect x="14" y="14" width="86" height="32" rx="4" class="hw-svg-frame" />
            <g class="hw-svg-metal" stroke-width="2">
              <circle cx="36" cy="30" r="9" />
              <circle cx="78" cy="30" r="9" />
              <path d="M36 24v12M30 30h12M78 24v12M72 30h12" />
            </g>
            <circle cx="36" cy="30" r="2.4" class="hw-svg-metal-fill" />
            <circle cx="78" cy="30" r="2.4" class="hw-svg-metal-fill" />
            {i === 0 ? (
              <g stroke="#D94F1E" stroke-width="2" fill="none">
                <circle cx="130" cy="30" r="10" />
                <path d="M130 15v5M130 40v5M115 30h5M140 30h5" />
              </g>
            ) : (
              <path d="M110 30h10l3-7 4 14 3-7h20" stroke="#D94F1E" stroke-width="2" fill="none" />
            )}
          </svg>
          <div class="flex flex-col min-w-0 mt-4 sm:mt-0">
            <h3 class="t-head font-black tracking-tight m-0" style="overflow-wrap: anywhere;">
              {tool.name}
            </h3>
            <p class="mono t-sm text-muted m-0 mt-1">{tool.tech.join(", ")}</p>
            <p class="t-body text-muted leading-relaxed m-0 mt-3" style="text-wrap: pretty;">
              {tool.description}
            </p>
            <div class="mt-4">
              <span class="t-sm font-bold text-muted block mb-1.5">Install command</span>
              <code
                class="mono t-sm block rounded px-3 py-2.5 overflow-x-auto whitespace-nowrap m-0"
                style="background: var(--smoked); color: var(--led-side-a);"
              >
                {tool.command}
              </code>
            </div>
            <div class="flex flex-wrap gap-2 mt-3">
              <TransportKey copy={tool.command}>
                Copy command
              </TransportKey>
              {tool.docs && (
                <a class="hw-key" href={tool.docs} target="_blank" rel="noopener noreferrer">
                  Docs
                </a>
              )}
              {tool.github && (
                <a class="hw-key" href={tool.github} target="_blank" rel="noopener noreferrer">
                  GitHub
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="grid gap-4 mt-4 sm:grid-cols-3">
    {
      rack.map((p) => (
        <article class="hw-panel p-4 flex flex-col min-w-0" id={p.id}>
          <img
            src={`/projects/${p.slug}.svg`}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            width="1200"
            height="675"
            class="w-full aspect-video object-cover rounded-md border border-line"
          />
          <h3 class="t-body font-black m-0 mt-4" style="overflow-wrap: anywhere;">
            {p.name}
          </h3>
          <p class="mono t-sm text-muted m-0 mt-1">{p.tech.join(", ")}</p>
          <p class="t-sm text-muted leading-relaxed m-0 mt-2" style="text-wrap: pretty;">
            {p.description}
          </p>
          {p.github && (
            <a
              class="hw-key mt-auto self-start mt-4"
              href={p.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>

<script src="../scripts/copy-command.ts"></script>

---
type URL = `https://github.com/${string}/pull/${number}`;

interface Contribution {
  project: string;
  projectUrl: string;
  url: URL[];
}

const contributions: Contribution[] = [
  {
    project: "pangular-inspector",
    projectUrl: "https://github.com/pangular-inspector/devtools",
    url: [
      "https://github.com/pangular-inspector/devtools/pull/28",
      "https://github.com/pangular-inspector/devtools/pull/45",
      "https://github.com/pangular-inspector/devtools/pull/62",
      "https://github.com/pangular-inspector/devtools/pull/200",
      "https://github.com/pangular-inspector/devtools/pull/201",
    ]
  },
  {
    project: "spartan ng",
    projectUrl: "https://github.com/spartan-ng/spartan",
    url: [
      "https://github.com/spartan-ng/spartan/pull/981",
      "https://github.com/spartan-ng/spartan/pull/980",
      "https://github.com/spartan-ng/spartan/pull/979",
    ],
  },
  {
    project: "ng-primitives",
    projectUrl: "https://github.com/ng-primitives/ng-primitives",
    url: ["https://github.com/ng-primitives/ng-primitives/pull/499"],
  },
  {
    project: "ng-icons",
    projectUrl: "https://github.com/ng-icons/ng-icons",
    url: [
      "https://github.com/ng-icons/ng-icons/pull/202",
      "https://github.com/ng-icons/ng-icons/pull/203",
      "https://github.com/ng-icons/ng-icons/pull/204",
    ],
  },
  {
    project: "free-Code-Camp",
    projectUrl: "https://github.com/freeCodeCamp/freeCodeCamp",
    url: ["https://github.com/freeCodeCamp/freeCodeCamp/pull/62576"],
  },
  {
    project: "carbon-components-angular",
    projectUrl:
      "https://github.com/carbon-design-system/carbon-components-angular",
    url: [
      "https://github.com/carbon-design-system/carbon-components-angular/pull/2945",
      "https://github.com/carbon-design-system/carbon-components-angular/pull/2939",
      "https://github.com/carbon-design-system/carbon-components-angular/pull/2789",
      "https://github.com/carbon-design-system/carbon-components-angular/pull/2764",
      "https://github.com/carbon-design-system/carbon-components-angular/pull/2748",
      "https://github.com/carbon-design-system/carbon-components-angular/pull/2741",
      "https://github.com/carbon-design-system/carbon-components-angular/pull/2740",
    ],
  },
];

interface RepoMeta {
  description: string;
  language: string | null;
}

// Snapshots from the GitHub API, used when a build-time fetch fails
// or rate-limits so the hover card never renders empty.
const FALLBACK_META: Record<string, RepoMeta> = {
  "pangular-inspector/devtools": {
    description: "Angular DevTools: inspect components, signals, DI, and routes. Runs as a Chrome extension and standalone app.",
    language: "TypeScript",
  },
  "spartan-ng/spartan": {
    description: "Cutting-edge tools powering Angular full-stack development.",
    language: "TypeScript",
  },
  "ng-primitives/ng-primitives": {
    description: "Headless, composable primitives for building accessible UI components in Angular.",
    language: "TypeScript",
  },
  "ng-icons/ng-icons": {
    description: "The ultimate icon library for Angular",
    language: "TypeScript",
  },
  "freeCodeCamp/freeCodeCamp": {
    description: "freeCodeCamp.org's open-source codebase and curriculum. Learn math, programming, and computer science.",
    language: "TypeScript",
  },
  "carbon-design-system/carbon-components-angular": {
    description: "An Angular implementation of the Carbon Design System for IBM.",
    language: "TypeScript",
  },
};

async function fetchRepoMeta(slug: string): Promise<RepoMeta> {
  // Dev renders per-request: hitting the API there would stall every
  // page load. Snapshots keep dev instant; production builds (one
  // prerender per deploy) still fetch fresh data, capped by timeout.
  if (import.meta.env.DEV) return FALLBACK_META[slug] ?? { description: "", language: null };
  try {
    const res = await fetch(`https://api.github.com/repos/${slug}`, {
      headers: { Accept: "application/vnd.github+json", "User-Agent": "abikb-portfolio-build" },
      signal: AbortSignal.timeout(5000),
    });
    if (!res.ok) throw new Error(String(res.status));
    const d: any = await res.json();
    return {
      description: d.description ?? FALLBACK_META[slug]?.description ?? "",
      language: d.language ?? null,
    };
  } catch {
    return FALLBACK_META[slug] ?? { description: "", language: null };
  }
}



function extractPrNumber(url: string): string {
  return "#" + url.split("/pull/")[1];
}

function extractRepo(url: string): string {
  const match = url.match(/github\.com\/([^/]+\/[^/]+)/);
  return match ? match[1] : "";
}

const totalPRs = contributions.reduce((sum, c) => sum + c.url.length, 0);

const metaEntries = await Promise.all(
  contributions.map(async (c) => {
    const slug = extractRepo(c.projectUrl);
    return [slug, await fetchRepoMeta(slug)] as const;
  }),
);
const metaByRepo: Record<string, RepoMeta> = Object.fromEntries(metaEntries);
---

<section>
  <p class="text-sm text-secondary-dark mb-2" data-reveal>
    <strong class="text-accent font-semibold">{totalPRs} PRs</strong> merged across{" "}
    <strong class="text-accent font-semibold">{contributions.length} projects</strong>
  </p>
  <div>
    {
      contributions.map((c, i) => (
        <div class="group relative py-5 border-t border-line" data-reveal style={`--index:${i}`}>
          <div class="flex items-baseline justify-between gap-2 mb-2">
            <a
              href={c.projectUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-foreground-dark hover:text-accent transition"
              aria-describedby={`repo-card-${i}`}
            >
              {extractRepo(c.projectUrl)}
              <svg
                class="inline w-3.5 h-3.5 ml-1 opacity-40"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            </a>
            <span class="font-mono text-xs text-secondary-dark whitespace-nowrap">
              {c.url.length} {c.url.length === 1 ? "PR" : "PRs"}
            </span>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {c.url.map((url) => (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs px-2 py-1 rounded-full bg-surface-2 border border-line text-accent hover:border-accent transition"
              >
                {extractPrNumber(url)}
              </a>
            ))}
          </div>
          {(() => {
            const meta = metaByRepo[extractRepo(c.projectUrl)];
            return meta && meta.description ? (
              <div
                id={`repo-card-${i}`}
                role="note"
                class="hover-card absolute left-0 top-full z-20 mt-1 w-[min(20rem,80vw)] rounded-xl border border-line bg-surface p-4 shadow-[0_2px_8px_rgba(0,0,0,0.04)]"
              >
                <p class="text-sm text-secondary-dark leading-relaxed">{meta.description}</p>
                <div class="flex flex-wrap gap-x-4 gap-y-1 mt-3 font-mono text-xs text-secondary-dark">
                  {meta.language && <span>{meta.language}</span>}
                </div>
              </div>
            ) : null;
          })()}
        </div>
      ))
    }
  </div>
</section>

---
import { SIDE_A } from "../data/projects";
import TransportKey from "./cassette/TransportKey.astro";

// The two authored npm tools: the tuner's Side A headliners,
// presented here as cassette faceplates with real commands and docs.
const tools = SIDE_A.filter((p) => p.command);
---

<section class="w-full" aria-labelledby="tools-h">
  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 sm:gap-4 mb-5">
    <h2 id="tools-h" class="t-head font-black tracking-tight m-0 text-bench-text">Tools I've shipped</h2>
    <a
      href="/projects"
      class="t-sm font-bold text-leda underline decoration-2 underline-offset-4 hover:text-bench-text transition-colors"
    >
      More projects &rarr;
    </a>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    {
      tools.map((tool, i) => (
        <article class="hw-panel p-5 sm:p-6 flex flex-col min-w-0">
          <div class="flex items-center gap-4">
            <svg
              class="w-[132px] sm:w-[150px] h-auto shrink-0"
              viewBox="0 0 160 60"
              aria-hidden="true"
            >
              <rect x="2" y="4" width="156" height="52" rx="6" class="hw-svg-deck" />
              <rect x="14" y="14" width="86" height="32" rx="4" class="hw-svg-frame" />
              <g class="hw-svg-metal" stroke-width="2">
                <circle cx="36" cy="30" r="9" />
                <circle cx="78" cy="30" r="9" />
                <path d="M36 24v12M30 30h12M78 24v12M72 30h12" />
              </g>
              <circle cx="36" cy="30" r="2.4" class="hw-svg-metal-fill" />
              <circle cx="78" cy="30" r="2.4" class="hw-svg-metal-fill" />
              {i === 0 ? (
                <g stroke="#D94F1E" stroke-width="2" fill="none">
                  <circle cx="130" cy="30" r="10" />
                  <path d="M130 15v5M130 40v5M115 30h5M140 30h5" />
                </g>
              ) : (
                <path
                  d="M110 30h10l3-7 4 14 3-7h20"
                  stroke="#D94F1E"
                  stroke-width="2"
                  fill="none"
                />
              )}
            </svg>
            <div class="min-w-0">
              <h3 class="t-head font-black tracking-tight m-0" style="overflow-wrap: anywhere;">
                {tool.name}
              </h3>
              <p class="mono t-sm text-muted m-0 mt-1">{tool.tech.join(", ")}</p>
            </div>
          </div>

          <p class="t-body text-muted leading-relaxed m-0 mt-4" style="text-wrap: pretty;">
            {tool.description}
          </p>

          <div class="mt-auto pt-4">
            <span class="t-sm font-bold text-muted block mb-1.5">Install command</span>
            <code
              class="mono t-sm block rounded px-3 py-2.5 overflow-x-auto whitespace-nowrap m-0"
              style="background: var(--smoked); color: var(--led-side-a);"
            >
              {tool.command}
            </code>
          </div>
          <div class="flex flex-wrap gap-2 mt-3">
            <TransportKey copy={tool.command}>
              Copy command
            </TransportKey>
            {tool.docs && (
              <a class="hw-key" href={tool.docs} target="_blank" rel="noopener noreferrer">
                Docs
              </a>
            )}
            {tool.github && (
              <a class="hw-key" href={tool.github} target="_blank" rel="noopener noreferrer">
                GitHub
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<script src="../scripts/copy-command.ts"></script>

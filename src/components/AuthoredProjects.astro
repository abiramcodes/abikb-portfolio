---
import { featuredProjects } from "../data/content";
import ProjectCard from "./ProjectCard.astro";
---

<section>
  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 sm:gap-4 mb-6">
    <div>
      <h2 class="font-display text-2xl sm:text-3xl tracking-[-0.02em]">
        Tools I've shipped
      </h2>
      <p class="text-secondary-dark mt-2">
        Angular tooling I design, build, and maintain on npm.
      </p>
    </div>
    <a
      href="/projects"
      class="text-sm font-medium text-accent link-draw whitespace-nowrap inline-flex items-center min-h-11"
    >
      More projects &rarr;
    </a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {featuredProjects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

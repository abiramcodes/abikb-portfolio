---
interface SkillGroup {
  label: string;
  items: string[];
  primary?: boolean;
}

const groups: SkillGroup[] = [
  {
    label: "Frontend",
    primary: true,
    items: [
      "HTML",
      "CSS / SCSS",
      "JavaScript (ES6+)",
      "TypeScript",
      "Angular 20+",
      "React.js 19+",
      "Astro",
      "Micro-Frontends",
    ],
  },
  {
    label: "Libraries & Tools",
    items: [
      "Angular Material",
      "PrimeNG / Optimus UI",
      "Ionic 7+",
      "Git & GitHub",
      "RESTful APIs",
      "RxJs",
      "NgRx",
      "TanStack Query",
      "TanStack Table",
      "TanStack Form",
      "Zod",
      "TailwindCSS",
      "Native Federation",
      "Module Federation",
      "Rspack",
      "Figma (Basic)",
    ],
  },
  {
    label: "AI Tooling",
    items: [
      "Claude Code",
      "GitHub Copilot",
      "OpenCode",
      "Muse CLI",
      "Antigravity CLI",
      "Cursor CLI",
    ],
  },
];
---

<section class="hw-panel px-5 sm:px-6 py-2 w-full" aria-label="Specification plate">
  <dl class="m-0">
    {
      groups.map((group, i) => (
        <div
          class={`grid sm:grid-cols-[180px_1fr] gap-1 sm:gap-6 py-5 ${i > 0 ? "border-t border-line" : ""}`}
        >
          <dt
            class={`t-sm font-extrabold pt-1 m-0 ${group.primary ? "text-accent-strong" : "text-muted"}`}
          >
            {group.label}
          </dt>
          <dd class="t-body leading-loose m-0" style="text-wrap: pretty;">
            {group.items.map((skill, k) => (
              <span>
                <span class={group.primary ? "text-ink font-bold" : "text-muted"}>{skill}</span>
                {k < group.items.length - 1 && (
                  <span class="text-line" aria-hidden="true">
                    {" · "}
                  </span>
                )}
              </span>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

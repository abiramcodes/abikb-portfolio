---
import { skillGroups } from "../data/content";
---

<section>
  <div>
    {
      skillGroups.map((group) => (
        <div class="grid sm:grid-cols-[160px_1fr] gap-2 sm:gap-6 py-5 border-t border-line">
          <h2 class={`font-mono text-xs uppercase tracking-[0.08em] pt-1 ${group.primary ? "text-accent" : "text-secondary-dark"}`}>
            {group.label}
          </h2>
          <div class="flex flex-wrap gap-1.5">
            {group.items.map((skill) => (
              <span class={`text-sm px-2.5 py-1 rounded-full border border-line ${group.primary ? "bg-accent-2bg text-accent-2 font-medium" : "bg-surface-2 text-foreground-dark"}`}>
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

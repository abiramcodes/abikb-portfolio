---
interface SkillGroup {
  label: string;
  items: string[];
  primary?: boolean;
}

const groups: SkillGroup[] = [
  {
    label: "Frontend",
    primary: true,
    items: [
      "HTML",
      "CSS / SCSS",
      "JavaScript (ES6+)",
      "TypeScript",
      "Angular 20+",
      "React.js 19+",
      "Astro",
      "Micro-Frontends",
    ],
  },
  {
    label: "Libraries & Tools",
    items: [
      "Angular Material",
      "PrimeNG / Optimus UI",
      "Ionic 7+",
      "Git & GitHub",
      "RESTful APIs",
      "RxJs",
      "NgRx",
      "TanStack Query",
      "TanStack Table",
      "TanStack Form",
      "Zod",
      "TailwindCSS",
      "Native Federation",
      "Module Federation",
      "Rspack",
      "Figma (Basic)",
    ],
  },
  {
    label: "AI Tooling",
    items: [
      "Claude Code",
      "GitHub Copilot",
      "OpenCode",
      "Muse CLI",
      "Antigravity CLI",
      "Cursor CLI",
    ],
  },
];
---

<section>
  <div>
    {
      groups.map((group, i) => (
        <div
          class="grid sm:grid-cols-[180px_1fr] gap-1 sm:gap-6 py-6 border-t border-line"
          data-reveal
          style={`--index:${i}`}
        >
          <h3 class={`pt-1 font-medium ${group.primary ? "text-accent" : "text-secondary-dark"}`}>
            {group.label}
          </h3>
          <p
            class="leading-loose text-foreground-dark"
            style="text-wrap: pretty;"
          >
            {group.items.map((skill, k) => (
              <span>
                <span class={group.primary ? "text-foreground-dark" : "text-secondary-dark"}>
                  {skill}
                </span>
                {k < group.items.length - 1 && (
                  <span class="text-accent-2 select-none" aria-hidden="true"> · </span>
                )}
              </span>
            ))}
          </p>
        </div>
      ))
    }
  </div>
</section>

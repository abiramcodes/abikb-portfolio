---
interface SkillGroup {
  label: string;
  items: string[];
  primary?: boolean;
}

const groups: SkillGroup[] = [
  {
    label: "Frontend",
    primary: true,
    items: [
      "HTML",
      "CSS / SCSS",
      "JavaScript (ES6+)",
      "TypeScript",
      "Angular 20+",
      "React.js 19+",
      "Astro",
      "Micro-Frontends",
    ],
  },
  {
    label: "Libraries & Tools",
    items: [
      "Angular Material",
      "PrimeNG / Optimus UI",
      "Ionic 7+",
      "Git & GitHub",
      "RESTful APIs",
      "RxJs",
      "NgRx",
      "TanStack Query",
      "TanStack Table",
      "TanStack Form",
      "Zod",
      "TailwindCSS",
      "Native Federation",
      "Module Federation",
      "Rspack",
      "Figma (Basic)",
    ],
  },
  {
    label: "AI Tools",
    items: [
      "Claude Code",
      "GitHub Copilot / Copilot CLI",
      "Open Code",
      "Custom AI Agents",
    ],
  },
  {
    label: "Backend",
    items: [
      "Node.js (Learning)",
      "NestJS (Learning)",
      "Python",
      "Golang",
    ],
  },
];
---

<section>
  <h2 class="text-xl sm:text-2xl font-semibold mb-6">Skills</h2>
  <div class="space-y-5">
    {
      groups.map((group) => (
        <div>
          <h3 class={`text-sm font-medium mb-2 ${group.primary ? "text-accent" : "text-secondary-dark"}`}>
            {group.label}
          </h3>
          <div class="flex flex-wrap gap-2">
            {group.items.map((skill) => (
              <span class={`text-sm px-2.5 py-1 rounded-md ${group.primary ? "bg-accent/15 text-accent font-medium" : "bg-muted-dark text-foreground-dark"}`}>
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

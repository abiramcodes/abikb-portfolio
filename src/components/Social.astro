---
import { socials } from "../data/content";
---

<div class="flex items-center gap-1">
  {
    socials.map((link) => (
      <span class="group relative inline-flex">
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.label}
          aria-describedby={`social-card-${link.label}`}
          class="inline-flex p-3 text-secondary-dark hover:text-accent transition-colors duration-200 ease-out-strong"
        >
          <svg
            class="w-5 h-5"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path fill-rule="evenodd" d={link.icon} clip-rule="evenodd" />
          </svg>
        </a>
        <span
          id={`social-card-${link.label}`}
          role="note"
          class="hover-card absolute left-0 top-full z-20 mt-1 w-64 max-w-[80vw] rounded-xl border border-line bg-surface p-4 shadow-[0_2px_8px_rgba(0,0,0,0.04)]"
        >
          <span class="block font-mono text-xs text-accent">{link.handle}</span>
          {link.lines.map((line) => (
            <span class="block text-sm text-secondary-dark leading-relaxed mt-1">{line}</span>
          ))}
        </span>
      </span>
    ))
  }
</div>

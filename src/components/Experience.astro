---
interface Experience {
  company: string;
  role: string;
  duration: string;
  highlights: string[];
}

const experiences: Experience[] = [
  {
    company: "Deloitte USI",
    role: "Frontend Consultant",
    duration: "Jun 2025 — Present",
    highlights: [
      "Building scalable web applications using Angular 17+ and modern web technologies.",
      "Refactored existing codebases to improve performance, maintainability, and adherence to best practices.",
      "Optimized Angular components using OnPush strategy and lazy loading, resulting in faster load times.",
      "Spearheaded migrating the application from Angular 17 to Angular 20, ensuring compatibility and leveraging new features.",
      "Implemented unit tests using Jest and Karma, achieving <strong class='text-accent'>85%</strong> test coverage.",
      "Developed Proof of Concepts (PoCs) to demonstrate technical solutions for client proposals.",
      "Received the <strong class='text-accent'>Applause Award</strong> for executing a flawless migration from Angular 17 to v20 with zero defects.",
      "Engineered a <strong class='text-accent'>Micro Frontend</strong> architecture using Shell and Remote pattern, leading a team of 4 developers.",
      "Established core architecture and best practices, introducing <strong class='text-accent'>React 19</strong> methodologies to the project.",
      "Configured and optimized <strong class='text-accent'>Nginx and Ingress</strong> rules for seamless MFE routing and integration.",
      "Received a <strong class='text-accent'>2nd Applause Award</strong> for end-to-end setup and delivery of the MFE architecture using React 19.",
    ],
  },
  {
    company: "Tata Consultancy Services",
    role: "Frontend Developer",
    duration: "Dec 2021 — Jun 2025",
    highlights: [
      "Developed and maintained dynamic UI components using Angular 15+ and Angular Material.",
      "Optimized application performance by <strong class='text-accent'>50%</strong> through NgRx state management, reducing redundant API calls.",
      "Reduced page load times by <strong class='text-accent'>40%</strong> with virtual scrolling techniques.",
      "Improved test coverage to <strong class='text-accent'>80%</strong> with Jest, leading to better code quality and stability.",
      "Resolved <strong class='text-accent'>100+</strong> bugs and deployment issues, leveraging GitHub Actions for CI/CD on Azure.",
      "Collaborated with cross-functional teams within Agile/Scrum to deliver high-quality web solutions.",
      "Designed complex UI workflows across <strong class='text-accent'>5+</strong> major modules with accessibility compliance.",
      "Migrated an application from Angular 13 (Modular) to Angular 17 (Standalone Architecture).",
    ],
  },
];
---

<section class="w-full max-w-2xl mx-auto px-4 sm:px-0">
  <h2 class="text-xl sm:text-2xl font-semibold mb-8">Experience</h2>
  <div class="space-y-10">
    {
      experiences.map((exp) => (
        <div class="relative pl-5 border-l-2 border-muted-dark">
          <div class="absolute -left-[7px] top-1 w-3 h-3 rounded-full bg-accent" />
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-3">
            <div>
              <h3 class="text-lg sm:text-xl font-semibold">
                {exp.role}
              </h3>
              <p class="text-sm text-accent font-medium">{exp.company}</p>
            </div>
            <span class="text-sm text-secondary-dark whitespace-nowrap">
              {exp.duration}
            </span>
          </div>
          <ul class="space-y-2 text-sm sm:text-base text-secondary-dark">
            {exp.highlights.map((item) => (
              <li class="leading-relaxed" set:html={item} />
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

---
import { computeDuration } from "../utils/experience.ts";

interface HighlightGroup {
  category: string;
  items: string[];
}

interface Experience {
  company: string;
  role: string;
  duration: string;
  start: string;
  end: string;
  computed?: string;
  groups: HighlightGroup[];
}

const experiences: Experience[] = [
  {
    company: "Deloitte USI",
    role: "Frontend Consultant",
    duration: "Jun 2025 - Present",
    start: "Jun 2025",
    end: "Present",
    computed: computeDuration("Jun 2025", "Present"),
    groups: [
      {
        category: "Architecture & Delivery",
        items: [
          "Engineered a <strong class='text-accent'>Micro Frontend</strong> architecture using Shell and Remote pattern, leading a team of 4 developers.",
          "Configured and optimized <strong class='text-accent'>Nginx and Ingress</strong> rules for seamless MFE routing and integration.",
          "Established core architecture and best practices, introducing <strong class='text-accent'>React 19</strong> methodologies to the project.",
        ],
      },
      {
        category: "Migrations & Modernization",
        items: [
          "Migrated <strong class='text-accent'>PrimeNG to Optimus UI</strong> and <strong class='text-accent'>Angular 21 to 22</strong> with modern Signal APIs across <strong class='text-accent'>8 micro frontend</strong> repositories using Native Federation, leveraging AI agent tools (Claude Code, Copilot).",
          "Spearheaded migrating the application from Angular 17 to Angular 20, ensuring compatibility and leveraging new features.",
          "Modernized a legacy Angular project, significantly reducing build size and improving application performance.",
        ],
      },
      {
        category: "AI & Tooling",
        items: [
          "Authored custom AI agent skills for project needs (grill-me, architect) and curated open-source skills (<strong class='text-accent'>caveman, ponytail, Vercel React best practices, Angular skills</strong>) to optimize token usage and enforce coding standards.",
          "Developed Proof of Concepts (PoCs) to demonstrate technical solutions for client proposals.",
        ],
      },
      {
        category: "Quality & Recognition",
        items: [
          "Received the <strong class='text-accent'>Applause Award</strong> for executing a flawless migration from Angular 17 to v20 with zero defects.",
          "Received a <strong class='text-accent'>2nd Applause Award</strong> for end-to-end setup and delivery of the MFE architecture using React 19.",
          "Implemented unit tests using Jest and Karma, achieving <strong class='text-accent'>85%</strong> test coverage.",
        ],
      },
    ],
  },
  {
    company: "Tata Consultancy Services",
    role: "Frontend Developer",
    duration: "Dec 2021 - Jun 2025",
    start: "Dec 2021",
    end: "Jun 2025",
    computed: computeDuration("Dec 2021", "Jun 2025"),
    groups: [
      {
        category: "Performance & Quality",
        items: [
          "Optimized application performance by <strong class='text-accent'>50%</strong> through NgRx state management, reducing redundant API calls.",
          "Reduced page load times by <strong class='text-accent'>40%</strong> with virtual scrolling techniques.",
          "Improved test coverage to <strong class='text-accent'>80%</strong> with Jest, leading to better code quality and stability.",
        ],
      },
      {
        category: "Development & Delivery",
        items: [
          "Designed complex UI workflows across <strong class='text-accent'>5+</strong> major modules with accessibility compliance.",
          "Resolved <strong class='text-accent'>100+</strong> bugs and deployment issues, leveraging GitHub Actions for CI/CD on Azure.",
          "Migrated an application from Angular 13 (Modular) to Angular 17 (Standalone Architecture).",
          "Collaborated with cross-functional teams within Agile/Scrum to deliver high-quality web solutions.",
        ],
      },
    ],
  },
];
---

<section class="w-full max-w-3xl mx-auto px-4 sm:px-0">
  <h2 class="font-display text-4xl sm:text-5xl tracking-[-0.02em] mb-3">Experience</h2>
  <p class="text-secondary-dark mb-10" data-reveal>Roles, migrations, and recognition since Dec 2021.</p>
  <div class="space-y-10">
    {
      experiences.map((exp) => (
        <div class="relative pl-5 border-l border-line" data-reveal>
          <div class="absolute -left-1.75 top-1 w-3 h-3 rounded-full bg-accent" />
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-4">
            <div>
              <h3 class="text-lg sm:text-xl font-semibold">
                {exp.role}
              </h3>
              <p class="text-sm text-accent font-medium">{exp.company}</p>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-sm  whitespace-nowrap">
                {exp.duration}
              </span>
              {exp.computed && (
                <span class="text-xs  whitespace-nowrap" data-start={exp.start} data-end={exp.end}>
                  ({exp.computed})
                </span>
              )}
            </div>
          </div>
          <div class="space-y-4">
            {exp.groups.map((group) => (
              <div>
                <h4 class="text-xs font-medium uppercase tracking-wider text-accent/70 mb-2">
                  {group.category}
                </h4>
                <ul class="space-y-1.5 text-sm sm:text-base text-secondary-dark">
                  {group.items.map((item) => (
                    <li class="leading-relaxed" set:html={item} />
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  // Recompute "Present" tenures in the browser so they never freeze at
  // the build date. Same module as the build-time fallback above.
  import { computeDuration } from "../utils/experience.ts";

  document.querySelectorAll("[data-start]").forEach((el) => {
    const start = el.getAttribute("data-start");
    const end = el.getAttribute("data-end");
    if (start && end) el.textContent = `(${computeDuration(start, end)})`;
  });
</script>

---

<section class="w-full max-w-2xl mx-auto px-4 sm:px-0">
  <h2 class="text-xl sm:text-2xl font-semibold mb-8">Experience</h2>
  <div class="space-y-10">
    {
      experiences.map((exp) => (
        <div class="relative pl-5 border-l-2 border-muted-dark">
          <div class="absolute -left-1.75 top-1 w-3 h-3 rounded-full bg-accent" />
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-4">
            <div>
              <h3 class="text-lg sm:text-xl font-semibold">
                {exp.role}
              </h3>
              <p class="text-sm text-accent font-medium">{exp.company}</p>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-sm  whitespace-nowrap">
                {exp.duration}
              </span>
              {exp.computed && (
                <span class="text-xs  whitespace-nowrap">
                  ({exp.computed})
                </span>
              )}
            </div>
          </div>
          <div class="space-y-4">
            {exp.groups.map((group) => (
              <div>
                <h4 class="text-xs font-medium uppercase tracking-wider text-accent/70 mb-2">
                  {group.category}
                </h4>
                <ul class="space-y-1.5 text-sm sm:text-base text-secondary-dark">
                  {group.items.map((item) => (
                    <li class="leading-relaxed" set:html={item} />
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

---
interface HighlightGroup {
  category: string;
  items: string[];
}

interface Experience {
  company: string;
  role: string;
  duration: string;
  computed?: string;
  groups: HighlightGroup[];
}

function computeDuration(startStr: string, endStr: string): string {
  const parse = (s: string) => {
    const [mon, yr] = s.trim().split(" ");
    const months: Record<string, number> = {
      Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5,
      Jul: 6, Aug: 7, Sep: 8, Sept: 8, Oct: 9, Nov: 10, Dec: 11,
    };
    return new Date(parseInt(yr), months[mon] ?? 0);
  };
  const start = parse(startStr);
  const end = endStr === "Present" ? new Date() : parse(endStr);
  let yrs = end.getFullYear() - start.getFullYear();
  let mos = end.getMonth() - start.getMonth();
  if (mos < 0) { yrs--; mos += 12; }
  const parts: string[] = [];
  if (yrs > 0) parts.push(`${yrs} yr${yrs > 1 ? "s" : ""}`);
  if (mos > 0) parts.push(`${mos} mo`);
  return parts.join(" ") || "< 1 mo";
}

const experiences: Experience[] = [
  {
    company: "Deloitte USI",
    role: "Frontend Consultant",
    duration: "Jun 2025 - Present",
    computed: computeDuration("Jun 2025", "Present"),
    groups: [
      {
        category: "Architecture & Delivery",
        items: [

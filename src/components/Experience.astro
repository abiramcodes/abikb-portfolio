---
import { roles } from "../data/content";
---

<section class="w-full max-w-3xl mx-auto px-4 sm:px-0">
  <h1 class="font-display text-4xl sm:text-5xl tracking-[-0.02em] mb-3">Experience</h1>
  <p class="text-secondary-dark mb-10">Roles, migrations, and recognition since Dec 2021.</p>
  <div class="space-y-10">
    {
      roles.map((job) => (
        <div class="relative pl-5 border-l border-line">
          <div class="absolute -left-[7px] top-1 w-3 h-3 rounded-full bg-accent" />
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-4">
            <div>
              <h2 class="text-lg sm:text-xl font-semibold">{job.role}</h2>
              <p class="text-sm text-accent font-medium">{job.company}</p>
            </div>
            <span class="text-sm whitespace-nowrap">{job.duration}</span>
          </div>
          <ul class="space-y-1.5 text-sm sm:text-base text-secondary-dark" style="text-wrap: balance;">
            {job.highlights.map((h) => (
              <li class="leading-relaxed">{h}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

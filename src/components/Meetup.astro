---
interface Talk {
  title: string;
  event: string;
  eventUrl: string;
  date: string;
  demoUrl?: string;
}

const talks: Talk[] = [
  {
    title: "Building Flexible UI's with Dynamic Components and Forms in Angular",
    event: "ng-India Chennai",
    eventUrl: "https://www.nomadcoder.ai/event/8",
    date: "Sept 2025",
    demoUrl:
      "https://github.com/abiramcodes/dynamic-forms-demo/tree/development",
  },
];
---

<section>
  <h2 class="text-xl sm:text-2xl font-semibold mb-4">Speaking</h2>
  <div class="space-y-4">
    {
      talks.map((talk) => (
        <div class="flex flex-col gap-1">
          <p class="font-medium text-foreground-dark">
            {talk.title}
          </p>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-secondary-dark">
            <a
              href={talk.eventUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:brightness-125 transition"
            >
              {talk.event}
            </a>
            <span>{talk.date}</span>
            {talk.demoUrl && (
              <a
                href={talk.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent hover:brightness-125 transition"
              >
                Demo
                <svg
                  class="inline w-3 h-3 ml-0.5 opacity-50"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

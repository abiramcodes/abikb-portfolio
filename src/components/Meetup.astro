---
import { talks } from "../data/content";
---

<section>
  <h2 class="font-display text-2xl sm:text-3xl tracking-[-0.02em] mb-2">Talks</h2>
  <div class="space-y-4">
    {
      talks.map((talk) => (
        <div class="flex flex-col gap-1">
          <p class="font-medium text-foreground-dark text-balance">{talk.title}</p>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-secondary-dark">
            <a
              href={talk.eventUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent link-draw py-1"
            >
              {talk.event}
            </a>
            <span>{talk.date}</span>
            {talk.demoUrl && (
              <a
                href={talk.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent link-draw py-1"
              >
                Demo
                <svg
                  class="arrow-ext inline w-3 h-3 ml-0.5 opacity-50"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

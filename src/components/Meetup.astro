---
interface Talk {
  title: string;
  event: string;
  eventUrl: string;
  date: string;
  demoUrl?: string;
}

const talks: Talk[] = [
  {
    title: "Building Flexible UI's with Dynamic Components and Forms in Angular",
    event: "ng-India Chennai",
    eventUrl: "https://www.nomadcoder.ai/event/8",
    date: "Sept 2025",
    demoUrl:
      "https://github.com/abiramcodes/dynamic-forms-demo/tree/development",
  },
];
---

<div class="space-y-5">
  {
    talks.map((talk) => (
      <div class="flex flex-col gap-1.5">
        <p class="t-body text-ink font-bold m-0" style="text-wrap: balance;">
          {talk.title}
        </p>
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <a
            href={talk.eventUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mono t-sm font-bold text-accent-strong underline decoration-2 underline-offset-4 hover:text-ink transition-colors"
          >
            {talk.event}
          </a>
          <span class="mono t-sm text-muted tabular">{talk.date}</span>
          {talk.demoUrl && (
            <a
              href={talk.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mono t-sm font-bold text-accent-strong underline decoration-2 underline-offset-4 hover:text-ink transition-colors"
            >
              Demo
            </a>
          )}
        </div>
      </div>
    ))
  }
</div>

---
import { workCards } from "../data/content";
---

<section class="w-full max-w-3xl mx-auto px-4 sm:px-0">
  <h2 class="font-display text-4xl sm:text-5xl tracking-[-0.02em] mb-3">What I built at work</h2>
  <p class="text-secondary-dark mb-8">Selected work platforms and migrations.</p>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      workCards.map((p) => (
        <div class="rounded-xl border border-line bg-surface p-5 flex flex-col gap-2">
          <div class="flex items-baseline justify-between gap-2">
            <h3 class="font-medium text-foreground-dark">{p.title}</h3>
            <span class="text-xs text-accent whitespace-nowrap">{p.scale}</span>
          </div>
          <p class="text-sm text-secondary-dark leading-relaxed text-balance">{p.description}</p>
          <div class="flex flex-wrap gap-1.5">
            {p.stats.map((s) => (
              <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-accent-2bg text-accent-2">{s}</span>
            ))}
          </div>
          <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
            {p.tech.map((t) => (
              <span class="text-xs px-2 py-0.5 rounded-md bg-muted-dark text-secondary-dark">{t}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

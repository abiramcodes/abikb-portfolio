---
import { SIDE_B } from "../data/projects";
---

<section class="w-full" aria-labelledby="work-h">
  <h2 id="work-h" class="t-head font-black tracking-tight m-0">What I built at work</h2>
  <p class="t-body text-muted m-0 mt-1.5">Selected work platforms and migrations.</p>

  <div class="flex flex-col gap-4 mt-6">
    {
      SIDE_B.map((p) => (
        <article class="hw-panel p-5 sm:p-6 min-w-0" id={p.id}>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="t-body font-black m-0">{p.name}</h3>
            {p.scale && <span class="mono t-sm text-accent-strong font-semibold">{p.scale}</span>}
          </div>
          <p class="t-body text-muted leading-relaxed m-0 mt-2" style="text-wrap: pretty;">
            {p.description}
          </p>
          {p.stats && (
            <p class="mono t-sm text-ink font-semibold m-0 mt-3">{p.stats.join(" · ")}</p>
          )}
          <p class="mono t-sm text-muted m-0 mt-1.5" style="text-wrap: pretty;">
            {p.tech.join(" · ")}
          </p>
        </article>
      ))
    }
  </div>
</section>

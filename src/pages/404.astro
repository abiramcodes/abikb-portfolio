---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found · Abiram" description="This page does not exist on abikb.xyz.">
  <section
    class="crt-stage w-full flex-1 flex flex-col items-center justify-center gap-6 px-4 py-32 text-center"
  >
    <h1
      class="font-display font-bold tracking-[-0.02em] text-foreground-dark"
      style="font-size: clamp(3rem, 12vw, 9rem); line-height: 0.95;"
    >
      NO SIGNAL
    </h1>
    <p class="text-lg sm:text-xl text-secondary-dark">
      This page doesn't exist.
    </p>
    <a
      href="/"
      data-magnetic
      class="mt-2 text-sm font-medium px-4 py-2 rounded-md bg-accent text-background-dark hover:brightness-110 transition"
    >
      &larr; Back home
    </a>
  </section>
</BaseLayout>

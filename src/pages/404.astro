---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="flex flex-col items-center justify-center gap-4 px-4 py-32 text-center">
    <h1 class="text-6xl sm:text-8xl font-bold text-accent">404</h1>
    <p class="text-lg sm:text-xl text-secondary-dark">
      This page doesn't exist.
    </p>
    <a
      href="/"
      class="mt-4 text-sm font-medium text-accent hover:brightness-125 transition"
    >
      &larr; Back home
    </a>
  </section>
</BaseLayout>

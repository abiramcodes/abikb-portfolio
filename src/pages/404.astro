---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found · Abiram" description="This page does not exist on abikb.xyz.">
  <section class="flex flex-col items-center justify-center gap-4 px-4 py-32 text-center">
    <h1 class="font-display text-6xl sm:text-8xl text-clay">404</h1>
    <p class="text-lg sm:text-xl text-secondary-dark">
      This page doesn't exist.
    </p>
    <a href="/" class="mt-4 text-sm font-medium text-accent link-draw inline-flex items-center min-h-11 px-1">
      <span class="arr-back" aria-hidden="true">&larr;</span> Back home
    </a>
  </section>
</BaseLayout>

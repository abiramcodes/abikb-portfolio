---
import Social from "../components/Social.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Meetup from "../components/Meetup.astro";
import AuthoredProjects from "../components/AuthoredProjects.astro";
import { totalPRs, contributions, featuredProjects, talks } from "../data/content";
---

<BaseLayout wide>
  <div class="site-wrap px-4 sm:px-0 grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-12 xl:gap-16 pb-24 sm:pb-10">
    <!-- Identity rail: sticky on wide screens while work scrolls past. -->
    <section class="lg:sticky lg:top-20 self-start flex flex-col min-w-0">
      <h1 class="font-display text-4xl sm:text-5xl leading-[1.1] tracking-[-0.02em]" data-enter>
        Hey, I'm Abiram<span class="text-accent">.</span>
        <span class="block text-2xl sm:text-3xl text-secondary-dark mt-3 text-balance">
          I build micro frontends and Angular tooling.
        </span>
      </h1>
      <p class="mt-5 text-base sm:text-lg text-secondary-dark leading-relaxed max-w-xl" data-enter style="--index:1; text-wrap: pretty;">
        Frontend consultant at Deloitte USI, migrating large Angular apps and
        leading a micro frontend platform team of four — with React, Astro,
        and modern tooling where they fit better.
      </p>

      <div class="mt-8 flex flex-col gap-4" data-enter style="--index:2">
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3">
          <a href="/Abirama_Kannan_FE_Engineer.pdf" download data-magnetic class="btn btn-primary w-full sm:w-auto">
            Download resume
          </a>
          <a href="/projects" data-magnetic class="btn btn-secondary w-full sm:w-auto">
            View projects
          </a>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <Social />
          <a
            href="mailto:akbhere20@gmail.com"
            class="text-sm font-medium text-accent link-draw inline-flex items-center min-h-11 px-1"
          >
            Get in touch <span class="arr" aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <p class="text-xs font-mono text-secondary-dark text-balance">
          Author of {featuredProjects.length} npm packages · {totalPRs} merged OSS PRs across {contributions.length} projects · Speaker, {talks[0].event} '25
        </p>
      </div>
    </section>

    <div class="flex flex-col gap-12 sm:gap-16 min-w-0">
      <AuthoredProjects />
      <Meetup />
    </div>
  </div>
</BaseLayout>

---
import Social from "../components/Social.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Meetup from "../components/Meetup.astro";
import { getExperience } from "../utils/experience.ts";

const { exp } = getExperience();

const metrics = [
  { value: "20+", label: "PRs merged" },
  { value: "6", label: "OSS projects" },
  { value: "2", label: "Awards" },
  { value: "1", label: "Talk" },
];

const proof = [
  {
    label: "Current role",
    title: "Frontend Consultant",
    body: "Architecting a Shell + Remote micro frontend platform, leading a team of 4. Angular 17 to 20 migration shipped with zero defects.",
    href: "/experience",
    cta: "See experience",
  },
  {
    label: "Open source",
    title: "20 PRs across 6 projects",
    body: "Carbon Components Angular, Spartan NG, ng-primitives, freeCodeCamp and more — small fixes, features, and reviews in the open.",
    href: "/open-source",
    cta: "Browse contributions",
  },
  {
    label: "Migrations",
    title: "Angular 21 to 22, PrimeNG to Optimus UI",
    body: "Eight micro frontend repos modernized with Signal APIs and Native Federation, using AI coding agents to move faster.",
    href: "/projects",
    cta: "View projects",
  },
  {
    label: "Stack",
    title: "Angular, React, Astro, TypeScript",
    body: "Micro frontends, state-heavy dashboards, and performance work — 50% fewer redundant API calls, 40% faster page loads.",
    href: "/skills",
    cta: "Full skill list",
  },
];
---

<BaseLayout>
  <section class="flex flex-col gap-12 sm:gap-20 px-4 sm:px-6 pb-24 sm:pb-10">
    <div class="w-full max-w-3xl mx-auto flex flex-col min-w-0">
      <p class="font-mono text-xs uppercase tracking-[0.08em] text-secondary-dark" data-reveal>
        Frontend Engineer
      </p>
      <h1 class="font-display text-4xl sm:text-5xl leading-[1.1] tracking-[-0.02em] mt-4" data-reveal style="--index:1">
        Hey, I'm Abiram.
      </h1>
      <p class="mt-5 text-base sm:text-lg text-secondary-dark leading-relaxed max-w-xl" data-reveal style="--index:2">
        Frontend engineer with <strong class="text-foreground-dark font-medium" data-exp>{exp} years</strong> of
        experience building micro frontends and migrating large Angular apps —
        with React, Astro, and modern tooling where they fit better.
      </p>

      <div class="mt-8 flex flex-col gap-4" data-reveal style="--index:3">
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/Abirama_Kannan_FE_Engineer.pdf"
            download
            class="text-sm font-medium px-4 py-2 rounded-md bg-foreground-dark text-background-dark hover:opacity-85 transition"
          >
            Download resume
          </a>
          <a
            href="/projects"
            class="text-sm font-medium px-4 py-2 rounded-md border border-line bg-surface text-foreground-dark hover:border-accent transition"
          >
            View projects
          </a>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <Social />
          <a
            href="mailto:akbhere20@gmail.com"
            class="text-sm font-medium text-accent hover:underline underline-offset-4 transition"
          >
            Get in touch &rarr;
          </a>
        </div>
      </div>

      <!-- Stats, divided by hairlines -->
      <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 border-y border-line" data-reveal style="--index:4">
        {metrics.map((m) => (
          <div class="py-4 pr-4">
            <div class="font-display text-3xl text-foreground-dark">{m.value}</div>
            <div class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-secondary-dark mt-1">{m.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Proof grid -->
    <div class="w-full max-w-3xl mx-auto">
      <div class="grid sm:grid-cols-2 gap-3 sm:gap-4">
        {proof.map((card, i) => (
          <article
            class="rounded-xl border border-line bg-surface p-5 sm:p-6 flex flex-col gap-3"
            data-reveal
            style={`--index:${i}`}
          >
            <span class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-accent-2 bg-accent-2bg self-start px-2 py-1 rounded-full">
              {card.label}
            </span>
            <h2 class="font-semibold text-lg leading-snug">{card.title}</h2>
            <p class="text-sm text-secondary-dark leading-relaxed">{card.body}</p>
            <a href={card.href} class="mt-3 sm:mt-auto pt-1 sm:pt-2 text-sm font-medium text-accent hover:underline underline-offset-4 transition">
              {card.cta} &rarr;
            </a>
          </article>
        ))}
      </div>
    </div>

    <div class="w-full max-w-3xl mx-auto" data-reveal>
      <Meetup />
    </div>
  </section>
</BaseLayout>

<script>
  // Recompute in the browser so the deployed page never goes stale
  // between builds. Same module as the build-time fallback above.
  import { getExperience } from "../utils/experience.ts";

  const el = document.querySelector("[data-exp]");
  if (el) el.textContent = `${getExperience().exp} years`;
</script>

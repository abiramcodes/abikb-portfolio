---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthoredProjects from "../components/AuthoredProjects.astro";
import Meetup from "../components/Meetup.astro";
import Social from "../components/Social.astro";
import CassetteHero from "../components/cassette/CassetteHero.astro";
import ProjectTuner from "../components/cassette/ProjectTuner.astro";
import { SITE_DESCRIPTION } from "../consts";
import { BANKS } from "../data/projects";
import { getExperienceYears } from "../utils/career";

const first = BANKS.A[0];
const trackSub = `Track 1 of ${BANKS.A.length} · ${first.tech.join(", ")}`;
---

<BaseLayout description={SITE_DESCRIPTION}>
  <div
    class="mx-auto w-full max-w-[76rem] px-4 sm:px-6 pt-6 sm:pt-10 pb-24 sm:pb-16 flex flex-col gap-16 sm:gap-20"
  >
    <!-- The console: the full-width interactive stage -->
    <section
      class="hw-chassis p-4 sm:p-8 lg:p-10"
      id="af82"
      data-side="A"
      data-power="on"
      data-play="off"
      aria-label="Project console"
    >
      <span class="hw-screw left-3 top-3" aria-hidden="true"></span>
      <span class="hw-screw right-3 top-3" aria-hidden="true"></span>
      <span class="hw-screw left-3 bottom-3" aria-hidden="true"></span>
      <span class="hw-screw right-3 bottom-3" aria-hidden="true"></span>

      <CassetteHero trackName={first.name} trackSub={trackSub} expYears={getExperienceYears()} />
      <ProjectTuner />
    </section>

    <AuthoredProjects />

    <section class="hw-panel p-5 sm:p-6" aria-labelledby="speaking-h">
      <h2 id="speaking-h" class="t-head font-black tracking-tight m-0">Speaking</h2>
      <Meetup />
    </section>

    <section
      class="hw-panel p-5 sm:p-6 flex flex-wrap items-center justify-between gap-4 sm:gap-8"
      aria-labelledby="output-h"
    >
      <div>
        <h2 id="output-h" class="t-head font-black tracking-tight m-0">Output jacks</h2>
        <p class="t-body text-muted m-0 mt-1.5 measure">Direct lines for frontend work, speaking, or tools.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2.5">
        <a
          class="hw-key primary"
          href="mailto:akbhere20@gmail.com"
          aria-label="Email akbhere20@gmail.com"
        >
          Email
        </a>
        <Social />
        <a class="hw-key" href="/Abirama_Kannan_FE_Engineer.pdf" download>Resume</a>
      </div>
    </section>
  </div>
</BaseLayout>

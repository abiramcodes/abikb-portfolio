---
import Social from "../components/Social.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Skills from "../components/Skills.astro";
import Meetup from "../components/Meetup.astro";
import OpenSource from "../components/OpenSource.astro";

const start = new Date(2021, 11); // Dec 2021
const now = new Date();
let years = now.getFullYear() - start.getFullYear();
let months = now.getMonth() - start.getMonth();
if (months < 0) {
  years--;
  months += 12;
}
const exp = months > 0 ? `${years}.${months}` : `${years}`;

const metrics = [
  { value: "20+", label: "PRs Merged" },
  { value: "6", label: "OS Projects" },
  { value: "2", label: "Awards" },
  { value: "1", label: "Talk" },
];
---

<BaseLayout>
  <section class="flex flex-col gap-16 sm:gap-20 px-4 sm:px-6 pb-24 sm:pb-10">
    <!-- Hero — the single orchestrated entrance -->
    <div class="w-full max-w-2xl mx-auto flex flex-col min-w-0 hero-reveal">
      <h1 class="text-2xl sm:text-3xl font-bold">Hey, I'm Abiram</h1>
      <p class="mt-4 text-base sm:text-lg text-secondary-dark leading-relaxed">
        Frontend engineer with <strong class="text-foreground-dark">{exp} years</strong> of
        experience, building performant web applications with Angular, React,
        and modern frontend tooling. I care about clean code, thoughtful UI,
        and shipping things that work well for real users.
      </p>
      <p class="mt-3 text-base sm:text-lg text-secondary-dark leading-relaxed">
        Currently at Deloitte, where I architect micro frontends, drive
        framework migrations, and leverage AI coding tools to move faster.
        Outside work, I contribute to open source and speak at meetups.
      </p>

      <!-- Metrics strip -->
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
        {metrics.map((m) => (
          <div class="flex items-baseline gap-1.5">
            <span class="text-lg font-semibold text-accent">{m.value}</span>
            <span class="text-sm text-secondary-dark">{m.label}</span>
          </div>
        ))}
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <Social />
        <a
          href="mailto:akbhere20@gmail.com"
          class="text-sm font-medium text-accent hover:brightness-125 transition"
        >
          Get in touch &rarr;
        </a>
      </div>
    </div>

    <div class="w-full max-w-2xl mx-auto flex flex-col min-w-0">
      <Skills />
    </div>

    <div class="w-full max-w-2xl mx-auto">
      <OpenSource />
    </div>

    <div class="w-full max-w-2xl mx-auto">
      <Meetup />
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthoredProjects from "../components/AuthoredProjects.astro";
import Meetup from "../components/Meetup.astro";
import Social from "../components/Social.astro";
import { SITE_DESCRIPTION } from "../consts";
---

<BaseLayout description={SITE_DESCRIPTION}>
  <!-- Hero: monumental phosphor type rising over the live bench -->
  <section class="crt-stage w-full">
    <div class="hero-copy w-full max-w-3xl mx-auto px-4 sm:px-6 pt-10 sm:pt-16">
      <h1 class="hero-name font-display font-bold text-foreground-dark" data-reveal>
        ABIRAM<span class="cursor-block" aria-hidden="true"></span>
      </h1>
      <p
        class="mt-6 sm:mt-8 max-w-xl text-base sm:text-lg text-secondary-dark leading-relaxed"
        data-reveal
        style="--index:1; text-wrap: pretty;"
      >
        Frontend engineer building micro frontends and migrating large Angular
        apps - with React, Astro, and modern tooling where they fit better.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3" data-reveal style="--index:2">
        <a
          href="/Abirama_Kannan_FE_Engineer.pdf"
          download
          data-magnetic
          class="text-sm font-medium px-4 py-2 rounded-md bg-accent text-background-dark hover:brightness-110 transition"
        >
          Download resume
        </a>
        <a
          href="/projects"
          data-magnetic
          class="text-sm font-medium px-4 py-2 rounded-md border border-line bg-surface text-foreground-dark hover:border-accent transition"
        >
          View projects
        </a>
      </div>
    </div>

    <div class="bench-stage w-full mt-10 sm:mt-16" data-reveal style="--index:3">
      <canvas id="bench" class="bench-canvas" aria-hidden="true"></canvas>
    </div>
  </section>

  <div
    class="w-full max-w-3xl mx-auto px-4 sm:px-0 pt-16 sm:pt-20 pb-24 sm:pb-10 flex flex-col gap-16 sm:gap-20"
  >
    <AuthoredProjects />

    <section data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl mb-4">Speaking</h2>
      <Meetup />
    </section>

    <section data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl mb-6">Off the clock</h2>
      <ul class="grid sm:grid-cols-3">
        <li class="flex items-center gap-3 py-4 border-t border-line">
          <svg
            class="w-5 h-5 shrink-0 text-accent-2"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4.5 19.5 11.5 12.5" stroke-width="5.5" />
            <path d="M11.5 12.5 17 7" stroke-width="2.5" />
            <circle cx="18.5" cy="18.5" r="2.6" />
          </svg>
          <span class="font-medium">Cricket</span>
        </li>
        <li class="flex items-center gap-3 py-4 border-t border-line sm:border-l sm:pl-6">
          <svg
            class="w-5 h-5 shrink-0 text-accent-2"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="6.5" r="2.75" />
            <path d="M9.5 9.5c-.5 3-1.7 5-3.2 6h11.4c-1.5-1-2.7-3-3.2-6" />
            <path d="M6.5 19.5h11" />
          </svg>
          <span class="font-medium">Chess</span>
        </li>
        <li class="flex items-center gap-3 py-4 border-t border-line sm:border-l sm:pl-6">
          <svg
            class="w-5 h-5 shrink-0 text-accent-2"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6.5 6.5v11M17.5 6.5v11M3.5 9v6M20.5 9v6M6.5 12h11" />
          </svg>
          <span class="font-medium">Working out</span>
        </li>
      </ul>
    </section>

    <section data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl mb-6">Get in touch</h2>
      <div class="terminal-block">
        <div class="terminal-bar">
          <span class="traffic" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>abiram@portfolio:~</span>
        </div>
        <div class="terminal-body">
          <p class="prompt-line">
            <span class="prompt" aria-hidden="true">&gt;</span>
            <a
              href="mailto:akbhere20@gmail.com"
              class="text-accent link-draw transition break-all"
            >
              mail akbhere20@gmail.com
            </a>
            <span class="cursor-block" aria-hidden="true"></span>
          </p>
          <div class="mt-6">
            <Social />
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* The name tracks its container width exactly: 6 mono advances
     (0.6em each) + the cursor block (0.67em) = 4.27em, so 23cqw
     fills ~98% of the column at every viewport. */
  .hero-copy {
    container-type: inline-size;
  }
  .hero-name {
    line-height: 0.95;
    letter-spacing: -0.02em;
    white-space: nowrap;
    font-size: clamp(3.25rem, 18vw, 13rem);
  }
  @supports (font-size: 1cqw) {
    .hero-name {
      font-size: min(23cqw, 13rem);
    }
  }
</style>

<script>
  // ── The bench: a living PCB stage ──
  // A deterministic scene (seeded PRNG) prerendered to a static
  // layer, with signal pulses riding the copper traces. The pointer
  // is the probe: moving near a trace injects pulses, clicking drops
  // a ping. The waveform strip is driven by real pointer energy, not
  // fake telemetry. Reduced-motion visitors get one static frame.
  const canvas = document.getElementById("bench") as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const WAVE_H = 46;
    const WAVE_N = 160;
    let W = 0;
    let H = 0;
    let dpr = 1;
    let colors = readColors();
    let staticLayer: HTMLCanvasElement | null = null;

    interface Pt {
      x: number;
      y: number;
    }
    interface Trace {
      pts: Pt[];
      cum: number[];
      len: number;
    }
    interface Chip {
      x: number;
      y: number;
      w: number;
      h: number;
      label: string;
    }
    interface Pulse {
      ti: number;
      t: number;
      dir: number;
      v: number;
    }
    interface Ripple {
      x: number;
      y: number;
      born: number;
      strong: boolean;
    }

    let traces: Trace[] = [];
    let chips: Chip[] = [];
    let vias: Pt[] = [];
    let pulses: Pulse[] = [];
    let ripples: Ripple[] = [];
    const wave: number[] = new Array(WAVE_N).fill(0);
    let phase = 0;
    let energy = 0;

    function readColors() {
      const cs = getComputedStyle(document.documentElement);
      return {
        copper: cs.getPropertyValue("--accent-2").trim() || "#c98a3d",
        amber: cs.getPropertyValue("--accent").trim() || "#ffb454",
        ink: cs.getPropertyValue("--muted-text").trim() || "#a08c5f",
        bg: cs.getPropertyValue("--bg").trim() || "#141008",
      };
    }

    function mulberry32(seed: number) {
      return () => {
        seed |= 0;
        seed = (seed + 0x6d2b79f5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    // ── Scene: PCB routing across the board ──
    function buildScene() {
      const rand = mulberry32(0x41424952); // "ABIR"
      traces = [];
      chips = [];
      vias = [];

      const boardH = H - WAVE_H;
      const count = Math.max(5, Math.round(W / 190));
      for (let i = 0; i < count; i++) {
        const pts: Pt[] = [];
        let x = -12;
        let y = boardH * (0.12 + rand() * 0.74);
        pts.push({ x, y });
        const jogs = 2 + Math.floor(rand() * 3);
        for (let j = 0; j < jogs && x < W; j++) {
          x += 60 + rand() * Math.min(200, W / 3);
          y = Math.min(boardH * 0.92, Math.max(boardH * 0.08, y + (rand() - 0.5) * boardH * 0.5));
          pts.push({ x: Math.min(x, W + 12), y });
          const jog = (rand() > 0.5 ? 1 : -1) * (14 + rand() * 34);
          const ny = Math.min(boardH * 0.92, Math.max(boardH * 0.08, y + jog));
          x += Math.abs(ny - y);
          y = ny;
          if (x > W + 12) break;
          pts.push({ x, y });
        }
        const lastY = Math.min(boardH * 0.92, Math.max(boardH * 0.08, y + (rand() - 0.5) * 40));
        pts.push({ x: W + 12, y: lastY });

        const cum = [0];
        let len = 0;
        for (let k = 1; k < pts.length; k++) {
          len += Math.hypot(pts[k].x - pts[k - 1].x, pts[k].y - pts[k - 1].y);
          cum.push(len);
        }
        traces.push({ pts, cum, len });
      }

      const labels = ["U1", "U2", "R7", "C3", "U4"];
      const chipCount = Math.max(2, Math.round(W / 420));
      for (let i = 0; i < chipCount; i++) {
        const w = 64 + rand() * 56;
        const h = 34 + rand() * 22;
        chips.push({
          x: (W - w) * (0.06 + rand() * 0.88),
          y: (boardH - h) * (0.08 + rand() * 0.84),
          w,
          h,
          label: labels[i % labels.length],
        });
      }

      const viaCount = Math.round(W / 90);
      for (let i = 0; i < viaCount; i++) {
        vias.push({ x: rand() * W, y: 12 + rand() * Math.max(10, boardH - 24) });
      }
    }

    function pointAt(tr: Trace, d: number): Pt {
      const c = tr.cum;
      let lo = 1;
      let hi = c.length - 1;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        if (c[mid] < d) lo = mid + 1;
        else hi = mid;
      }
      const seg = Math.max(1, lo);
      const t = (d - c[seg - 1]) / (c[seg] - c[seg - 1] || 1);
      const a = tr.pts[seg - 1];
      const b = tr.pts[seg];
      return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t };
    }

    // ── Static layer: traces, vias, chips, drawn once per size/theme ──
    function renderStatic() {
      staticLayer = document.createElement("canvas");
      staticLayer.width = Math.max(1, W * dpr);
      staticLayer.height = Math.max(1, H * dpr);
      const s = staticLayer.getContext("2d")!;
      s.setTransform(dpr, 0, 0, dpr, 0, 0);
      const boardH = H - WAVE_H;

      s.strokeStyle = colors.copper;
      s.lineWidth = 1.4;
      s.globalAlpha = 0.55;
      for (const tr of traces) {
        s.beginPath();
        tr.pts.forEach((p, i) => (i ? s.lineTo(p.x, p.y) : s.moveTo(p.x, p.y)));
        s.stroke();
        for (const p of [tr.pts[0], tr.pts[tr.pts.length - 1]]) {
          if (p.x < -5 || p.x > W + 5) continue;
          s.beginPath();
          s.arc(p.x, p.y, 2.6, 0, Math.PI * 2);
          s.fillStyle = colors.copper;
          s.fill();
        }
      }

      s.globalAlpha = 0.8;
      for (const v of vias) {
        s.beginPath();
        s.arc(v.x, v.y, 2.6, 0, Math.PI * 2);
        s.strokeStyle = colors.copper;
        s.lineWidth = 1.2;
        s.stroke();
        s.beginPath();
        s.arc(v.x, v.y, 0.9, 0, Math.PI * 2);
        s.fillStyle = colors.bg;
        s.fill();
      }

      s.globalAlpha = 1;
      for (const c of chips) {
        s.strokeStyle = colors.ink;
        s.globalAlpha = 0.5;
        s.lineWidth = 1;
        s.strokeRect(c.x, c.y, c.w, c.h);
        s.beginPath();
        const pins = Math.max(3, Math.floor(c.h / 10));
        for (let k = 0; k < pins; k++) {
          const py = c.y + ((k + 0.5) * c.h) / pins;
          s.moveTo(c.x - 4, py);
          s.lineTo(c.x, py);
          s.moveTo(c.x + c.w, py);
          s.lineTo(c.x + c.w + 4, py);
        }
        s.stroke();
        s.globalAlpha = 0.75;
        s.fillStyle = colors.ink;
        s.font = "600 11px 'Geist Mono', monospace";
        s.fillText(c.label, c.x + 6, c.y + 15);
        s.fillStyle = colors.copper;
        s.globalAlpha = 0.6;
        s.beginPath();
        s.arc(c.x + 6, c.y + c.h - 6, 1.6, 0, Math.PI * 2);
        s.fill();
      }

      s.globalAlpha = 0.3;
      s.strokeStyle = colors.ink;
      s.lineWidth = 1;
      s.beginPath();
      s.moveTo(0, boardH + 0.5);
      s.lineTo(W, boardH + 0.5);
      s.stroke();
    }

    // ── Amber glow sprite for pulses (rebuilt per theme) ──
    const sprite = document.createElement("canvas");
    sprite.width = sprite.height = 64;
    function makeSprite() {
      const g = sprite.getContext("2d")!;
      const m = colors.amber.replace("#", "");
      const n = m.length === 6 ? parseInt(m, 16) : 0xffb454;
      const rgb = `${(n >> 16) & 255},${(n >> 8) & 255},${n & 255}`;
      g.clearRect(0, 0, 64, 64);
      const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
      grad.addColorStop(0, `rgba(${rgb},1)`);
      grad.addColorStop(0.3, `rgba(${rgb},0.5)`);
      grad.addColorStop(1, `rgba(${rgb},0)`);
      g.fillStyle = grad;
      g.fillRect(0, 0, 64, 64);
    }

    function spawnPulse(ti: number, t: number, dir: number, v = 140 + Math.random() * 90) {
      if (pulses.length >= 18) return;
      pulses.push({ ti, t, dir, v });
    }

    function drawPulses(dt: number) {
      for (let i = pulses.length - 1; i >= 0; i--) {
        const p = pulses[i];
        const tr = traces[p.ti];
        if (!tr) {
          pulses.splice(i, 1);
          continue;
        }
        p.t += (p.dir * p.v * dt) / tr.len;
        if (p.t <= 0 || p.t >= 1) {
          pulses.splice(i, 1);
          continue;
        }
        const pos = pointAt(tr, p.t * tr.len);
        for (let k = 1; k <= 3; k++) {
          const bt = p.t - (p.dir * k * 14) / tr.len;
          if (bt <= 0 || bt >= 1) continue;
          const gp = pointAt(tr, bt * tr.len);
          ctx.globalAlpha = 0.5 / k;
          ctx.drawImage(sprite, gp.x - 10, gp.y - 10, 20, 20);
        }
        ctx.globalAlpha = 0.95;
        ctx.drawImage(sprite, pos.x - 13, pos.y - 13, 26, 26);
        ctx.fillStyle = colors.amber;
        ctx.fillRect(pos.x - 1, pos.y - 1, 2, 2);
      }
      ctx.globalAlpha = 1;
    }

    function drawRipples(now: number) {
      for (let i = ripples.length - 1; i >= 0; i--) {
        const r = ripples[i];
        const age = now - r.born;
        const alpha = 1 - age / 700;
        if (alpha <= 0) {
          ripples.splice(i, 1);
          continue;
        }
        const radius = age * 0.09;
        ctx.strokeStyle = colors.amber;
        ctx.lineWidth = r.strong ? 1.6 : 1;
        ctx.globalAlpha = alpha * (r.strong ? 0.7 : 0.4);
        ctx.beginPath();
        ctx.arc(r.x, r.y, radius, 0, Math.PI * 2);
        ctx.stroke();
        if (r.strong) {
          ctx.globalAlpha = alpha * 0.35;
          ctx.beginPath();
          ctx.arc(r.x, r.y, radius * 0.6, 0, Math.PI * 2);
          ctx.stroke();
        }
      }
      ctx.globalAlpha = 1;
    }

    function drawWave(dt: number) {
      const boardH = H - WAVE_H;
      const mid = boardH + WAVE_H / 2;
      phase += dt * (0.0035 + energy * 0.012);
      wave.push(Math.sin(phase) * (2 + energy * 9));
      wave.shift();
      ctx.globalAlpha = 0.9;
      ctx.strokeStyle = colors.amber;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      for (let i = 0; i < WAVE_N; i++) {
        const x = (i / (WAVE_N - 1)) * W;
        const y = mid - wave[i];
        if (i) ctx.lineTo(x, y);
        else ctx.moveTo(x, y);
      }
      ctx.stroke();
      ctx.globalAlpha = 1;
    }

    // ── The probe: nearest trace point within radius ──
    function nearest(x: number, y: number, radius: number) {
      let best: { ti: number; t: number; d: number; x: number; y: number } | null = null;
      for (let ti = 0; ti < traces.length; ti++) {
        const tr = traces[ti];
        for (let d = 0; d <= tr.len; d += 26) {
          const p = pointAt(tr, d);
          const dist = Math.hypot(p.x - x, p.y - y);
          if (dist < (best?.d ?? radius)) best = { ti, t: d / tr.len, d: dist, x: p.x, y: p.y };
        }
      }
      return best && best.d <= radius ? best : null;
    }

    let lastMove = 0;
    let lastX = 0;
    let lastY = 0;
    let lastSpawnAt = 0;

    canvas.addEventListener(
      "pointermove",
      (e) => {
        if (reduced) return;
        const r = canvas.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        const now = performance.now();
        const v = Math.hypot(x - lastX, y - lastY) / Math.max(16, now - lastMove);
        energy = Math.min(3.5, energy + v * 1.6);
        lastX = x;
        lastY = y;
        lastMove = now;

        if (now - lastSpawnAt > 110) {
          const hit = nearest(x, y, 46);
          if (hit) {
            spawnPulse(hit.ti, hit.t, Math.random() > 0.5 ? 1 : -1);
            ripples.push({ x: hit.x, y: hit.y, born: now, strong: false });
            lastSpawnAt = now;
          }
        }
      },
      { passive: true },
    );

    canvas.addEventListener(
      "pointerdown",
      (e) => {
        if (reduced) return;
        const r = canvas.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        const hit = nearest(x, y, 120);
        const px = hit ? hit.x : x;
        const py = hit ? hit.y : y;
        ripples.push({ x: px, y: py, born: performance.now(), strong: true });
        if (hit) {
          spawnPulse(hit.ti, hit.t, 1, 220);
          spawnPulse(hit.ti, hit.t, -1, 220);
          spawnPulse(hit.ti, hit.t, 1, 160);
        }
        energy = Math.min(4, energy + 1.8);
      },
      { passive: true },
    );

    // ── Loop: only while visible, never under reduced motion ──
    let rafId = 0;
    let lastFrame = 0;
    let lastAuto = 0;
    let nextAuto = 600;

    function frame(now: number) {
      const dt = Math.min(48, now - lastFrame || 16);
      lastFrame = now;
      ctx.clearRect(0, 0, W, H);
      if (staticLayer) ctx.drawImage(staticLayer, 0, 0, W, H);

      if (now - lastAuto > nextAuto) {
        lastAuto = now;
        nextAuto = 380 + Math.random() * 520;
        if (traces.length) {
          spawnPulse(
            Math.floor(Math.random() * traces.length),
            0.05 + Math.random() * 0.9,
            Math.random() > 0.5 ? 1 : -1,
          );
        }
      }
      drawPulses(dt);
      drawRipples(now);
      energy *= Math.exp(-dt / 650);
      drawWave(dt);
      rafId = requestAnimationFrame(frame);
    }

    function drawStaticFrame() {
      ctx.clearRect(0, 0, W, H);
      if (staticLayer) ctx.drawImage(staticLayer, 0, 0, W, H);
      const boardH = H - WAVE_H;
      const mid = boardH + WAVE_H / 2;
      ctx.globalAlpha = 0.85;
      ctx.strokeStyle = colors.amber;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      for (let i = 0; i < WAVE_N; i++) {
        const x = (i / (WAVE_N - 1)) * W;
        const y = mid - Math.sin((i / WAVE_N) * Math.PI * 6) * 2.2;
        if (i) ctx.lineTo(x, y);
        else ctx.moveTo(x, y);
      }
      ctx.stroke();
      // two resting pulses so the board still reads as powered
      ctx.globalAlpha = 0.95;
      for (const fx of [0.22, 0.68]) {
        const tr = traces[Math.floor(fx * traces.length) % Math.max(1, traces.length)];
        if (!tr) break;
        const p = pointAt(tr, tr.len * fx);
        ctx.drawImage(sprite, p.x - 13, p.y - 13, 26, 26);
        ctx.fillStyle = colors.amber;
        ctx.fillRect(p.x - 1, p.y - 1, 2, 2);
      }
      ctx.globalAlpha = 1;
    }

    function resize() {
      dpr = Math.min(2, window.devicePixelRatio || 1);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = Math.max(1, W * dpr);
      canvas.height = Math.max(1, H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      buildScene();
      makeSprite();
      renderStatic();
      if (reduced) drawStaticFrame();
    }

    new ResizeObserver(resize).observe(canvas);

    // Theme flips repaint the board in place.
    new MutationObserver(() => {
      colors = readColors();
      makeSprite();
      renderStatic();
      if (reduced) drawStaticFrame();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    if (!reduced) {
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting && !rafId) {
          lastFrame = performance.now();
          rafId = requestAnimationFrame(frame);
        } else if (!entry.isIntersecting && rafId) {
          cancelAnimationFrame(rafId);
          rafId = 0;
        }
      }).observe(canvas);
    }
  }
</script>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Project from "../components/Projects.astro";
import WorkProjects from "../components/WorkProjects.astro";
---

<BaseLayout title="Projects · Abiram" description="Selected work platforms, migrations, and side projects by Abiram — micro frontends, Angular modernization, and open-source tools.">
  <div class="mx-auto w-full max-w-[76rem] px-4 sm:px-6 pt-10 sm:pt-14 pb-24 sm:pb-16 flex flex-col gap-12 sm:gap-16">
    <header class="w-full">
      <h1 class="page-h1">Projects</h1>
      <hr class="seam" aria-hidden="true" />
    </header>
    <Project />
    <WorkProjects />
  </div>
</BaseLayout>

<style>
  .page-h1 {
    margin: 0;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 0.95;
    color: var(--bench-text);
  }
  .seam {
    border: 0;
    border-top: 1px solid var(--bench-line);
    margin: 20px 0 0;
  }
</style>

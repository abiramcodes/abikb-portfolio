---
import BaseLayout from "../layouts/BaseLayout.astro";
import Exp from "../components/Experience.astro";
---

<BaseLayout title="Experience · Abiram" description="Work experience of Abiram, Frontend Consultant at Deloitte USI — micro frontend architecture, framework migrations, and awards.">
  <div class="mx-auto w-full max-w-[76rem] px-4 sm:px-6 pt-10 sm:pt-14 pb-24 sm:pb-16 flex flex-col gap-8">
    <header class="w-full">
      <h1 class="page-h1">Experience</h1>
      <p class="t-body text-bench-muted m-0 mt-4 measure">
        Roles, migrations, and recognition since Dec 2021.
      </p>
      <hr class="seam" aria-hidden="true" />
    </header>
    <Exp />
  </div>
</BaseLayout>

<style>
  .page-h1 {
    margin: 0;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 0.95;
    color: var(--bench-text);
  }
  .seam {
    border: 0;
    border-top: 1px solid var(--bench-line);
    margin: 20px 0 0;
  }
</style>

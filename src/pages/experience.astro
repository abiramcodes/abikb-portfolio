  <section class="w-full max-w-3xl mx-auto px-4 sm:px-0 pt-10 sm:pt-14 pb-24 sm:pb-10">
    <h1 class="font-display text-4xl sm:text-5xl tracking-[-0.02em] mb-3">Experience</h1>

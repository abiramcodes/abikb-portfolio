---
import BaseLayout from "../layouts/BaseLayout.astro";
import OpenSource from "../components/OpenSource.astro";
import { totalPRs } from "../data/content";
---

<BaseLayout title="Open Source · Abiram" description={`Open source contributions by Abiram — ${totalPRs} PRs across Carbon Components Angular, Spartan NG, ng-primitives, freeCodeCamp, and more.`}>
  <section class="w-full max-w-3xl mx-auto px-4 sm:px-0 pb-24 sm:pb-10">
    <h1 class="font-display text-4xl sm:text-5xl tracking-[-0.02em] mb-3">Open Source</h1>
    <p class="text-secondary-dark mb-8">
      Contributions to projects I use and learn from.
    </p>
    <OpenSource />
  </section>
</BaseLayout>

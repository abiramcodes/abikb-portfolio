---
import BaseLayout from "../layouts/BaseLayout.astro";
import Skills from "../components/Skills.astro";
---

<BaseLayout title="Skills · Abiram" description="Skills of Abiram — Angular, React, TypeScript, Astro, micro frontends, and the tooling around them.">
  <section class="w-full max-w-3xl mx-auto px-4 sm:px-0 pb-24 sm:pb-10">
    <h1 class="font-display text-4xl sm:text-5xl tracking-[-0.02em] mb-3">Skills</h1>
    <p class="text-secondary-dark mb-8" data-reveal>
      The stack I reach for daily, plus the tools around it.
    </p>
    <Skills />
  </section>
</BaseLayout>
